import spacy

nlp = spacy.load("en_core_web_sm")

text = "Google acquired a startup in Pune."
doc = nlp(text)

# 1. Display entities
print("Entities:")

for ent in doc.ents:
    print(ent.text, "->", ent.label_)

# 2. Use dependency parsing to extract relation
for token in doc:

    # Find the subject
    if token.dep_ == "nsubj":
        subject = token.text
        verb = token.head

        # Find the object of the verb
        for child in verb.children:
            if child.dep_ in ["dobj", "obj"]:
                object_word = child.text

                print("\nExtracted Relationship:")
                print(subject, "--", verb.text, "-->", object_word)
